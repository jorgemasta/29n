---
import '../styles/global.css';
import datos from '../../data/dataset.json';
import { aplicarModo, type Dataset, type Modo } from '../dataset';
import LetraInicial from '../components/LetraInicial.astro';

// Mode switch, at build time: `MODO=privado` (private prototype) also ships provisional sources
// (2023 programmes, party documents, public statements). Anything else ships only official
// programmes, so provisional data never reaches the public site.
const modo: Modo = process.env.MODO === 'privado' ? 'privado' : 'publico';
const dataset = aplicarModo(datos as Dataset, modo);
const esPrueba = dataset.origen !== 'real';
// Safe to inline in a <script type="application/json">: escape "<" so no "</script>" can close it.
const json = JSON.stringify(dataset).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>29N · Elige a ciegas</title>
    <meta name="description" content="Lee lo que proponen los partidos sin saber de quién es." />
    <LetraInicial />
  </head>
  <body>
    <header class="barra-sup">
      <a href="/" class="marca">29N</a>
      <button type="button" id="aa" class="boton-aa" aria-pressed="false" aria-label="Letra grande">Aa</button>
    </header>
    <main id="app" data-modo={modo}>
      {esPrueba && (
        <p class="aviso-prueba" role="note">
          <strong>Prototipo con datos de prueba.</strong> {dataset.nota}
        </p>
      )}
      {modo === 'privado' && (
        <p class="aviso-prueba" role="note">
          <strong>Modo privado:</strong> incluye fuentes provisionales (programas de 2023, documentos y declaraciones), marcadas como «solo privado» al revelar.
        </p>
      )}
      <div id="vista">
        <p class="gris">Cargando los temas…</p>
        <noscript><p>Esta página necesita JavaScript para barajar las propuestas en tu móvil.</p></noscript>
      </div>
    </main>
    <nav class="pestanas" aria-label="Secciones" hidden>
      <a href="#temas"><span aria-hidden="true">☰</span> Temas</a>
      <a href="#preguntar"><span aria-hidden="true">💬</span> Preguntar</a>
      <a href="#resultado"><span aria-hidden="true">📊</span> Mi resultado</a>
    </nav>
    <footer class="pie">
      <nav class="enlaces-pie" aria-label="Información">
        <a href="/metodologia/">Cómo funciona</a> · <a href="/partidos/">Partidos y programas</a> · <a href="https://github.com/jorgemasta/29n">Código abierto</a>
      </nav>
      Proyecto personal de Jorge Masta, sin afiliación a ningún partido. Nada de lo que eliges sale de tu móvil.
    </footer>
    <script is:inline type="application/json" id="datos" set:html={json} />
    <script>
      import { montarApp } from '../web/app';
      import { montarBotonLetra } from '../web/letra';
      import type { Dataset, Modo } from '../dataset/esquema';
      montarBotonLetra(document.getElementById('aa') as HTMLButtonElement);
      const app = document.getElementById('app')!;
      const dataset = JSON.parse(document.getElementById('datos')!.textContent!) as Dataset;
      montarApp(document.getElementById('vista')!, dataset, app.dataset.modo as Modo);
    </script>
  </body>
</html>
