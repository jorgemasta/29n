---
// Screen 13 "Partidos y programas": who is in, under which criterion, and each programme's state.
import InfoPage from '../components/InfoPage.astro';
import { dataset, shortDate, dayDate } from '../transparency/data';
import { manifestos, missingPartyUrl } from '../transparency';
import { SOURCE_LABEL } from '../web/labels';
import { REGISTRY } from '../registry/parties';
import { includedProvinces } from '../registry/inclusion';
import { provinceByCode } from '../registry/territory';

const { withManifesto, pending } = manifestos(dataset);
const provisionalIds = REGISTRY.some((r) => r.inclusion.candidatures.state === 'provisional');
---
<InfoPage title="Partidos y programas" description="Qué partidos aparecen en 29N, con qué criterio y el estado de su programa.">
  <h1>Partidos y programas</h1>
  <p>
    Cada partido aparece solo en las provincias donde se presenta. Elige tu provincia en el juego para ver
    los tuyos: <a href="/#provincia">Cambiar provincia</a>.
  </p>

  <h2>Con programa ({withManifesto.length})</h2>
  <ul class="party-rows" role="list">
    {withManifesto.map((p) => (
      <li class="party-row">
        <p class="name">{p.name} {p.test && <span class="label">PRUEBA</span>}</p>
        <p class="grey">{p.scope}{p.date && ` · publicado el ${dayDate(p.date)}`}{p.source && p.source !== 'manifesto-29n' && ` · ${SOURCE_LABEL[p.source]}`}</p>
        <p>
          <a href={p.url!} target="_blank" rel="noopener">{p.title ?? 'Programa'} (PDF ↗)</a>
          {p.report && <> · <a href={`/informes/${p.id}/`}>Informe de verificación</a></>}
        </p>
      </li>
    ))}
  </ul>

  <h2>⏳ Pendientes ({pending.length})</h2>
  {pending.length === 0 ? <p class="grey">Ninguno.</p> : (
    <>
      <ul class="party-rows" role="list">
        {pending.map((p) => (
          <li class="party-row">
            <p class="name">{p.name} {p.test && <span class="label">PRUEBA</span>}</p>
            <p class="grey">{p.scope}</p>
            <p>Aún no ha publicado su programa. Se añadirá solo en cuanto lo haga.</p>
          </li>
        ))}
      </ul>
      <p class="grey">Mientras falte, no aparece en los temas ni en tu resultado.</p>
    </>
  )}

  <p class="grey">Última comprobación: {shortDate(dataset.generated)}</p>

  <h2 id="criterio">Criterio de inclusión</h2>
  <p>
    Un partido aparece en tu provincia si <strong>su candidatura está proclamada en esa provincia</strong> y
    <strong>tiene representación actual en el Congreso o en el parlamento autonómico</strong> de tu comunidad.
    Es un criterio objetivo, que se puede comprobar en el BOE.
  </p>
  {provisionalIds && (
    <p class="zone-notice">
      Las candidaturas aún no están proclamadas. Mientras tanto, usamos una estimación provisional (dónde se
      presentó en 2023 o su comunidad), que se sustituirá por las listas publicadas en el BOE.
    </p>
  )}
  <details>
    <summary>Datos de cada partido registrado ({REGISTRY.length})</summary>
    <table class="rubric-table">
      <thead><tr><th scope="col">Partido</th><th scope="col">Representación</th><th scope="col">Dónde cuenta</th></tr></thead>
      <tbody>
        {REGISTRY.map((r) => {
          const provs = includedProvinces(r.inclusion);
          return (
            <tr>
              <th scope="row">{r.name}</th>
              <td>{r.inclusion.representation.congress ? 'Congreso' : 'Parlamento autonómico'}<br /><span class="grey">{r.representationSource}</span></td>
              <td>{provs.length === 52 ? 'Toda España' : provs.map((c) => provinceByCode(c)?.name ?? c).join(', ')}<br /><span class="grey">{r.inclusion.candidatures.source}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </details>
  <p>
    ¿Falta un partido que cumple el criterio?
  </p>
  <details class="report" id="falta-partido">
    <summary>Falta un partido</summary>
    <form id="missing-party-form">
      <label class="finder-label" for="mp-party">Partido que falta</label>
      <input id="mp-party" name="party" required maxlength="150" />
      <label class="finder-label" for="mp-provinces">Provincia(s) donde se presenta</label>
      <input id="mp-provinces" name="provinces" maxlength="300" />
      <label class="finder-label" for="mp-reason">Por qué cumple el criterio (enlace al BOE si puedes)</label>
      <textarea id="mp-reason" name="reason" rows="3" maxlength="1000"></textarea>
      <label class="finder-label" for="mp-link">Enlace a su programa (opcional)</label>
      <input id="mp-link" name="link" type="url" maxlength="300" placeholder="https://" />
      <button type="submit" class="secondary">Enviar aviso</button>
      <p class="note">Se publica como aviso público en GitHub, sin tu nombre y sin cuenta.</p>
      <div id="missing-party-state" role="status" aria-live="polite"></div>
    </form>
    <noscript><p><a href={missingPartyUrl()}>Abrir el aviso en GitHub ↗</a> (necesitas una cuenta de GitHub).</p></noscript>
  </details>
  <script>
    import { sendFeedback } from '../client/api';
    import { feedbackResult } from '../web/feedback';
    const form = document.getElementById('missing-party-form') as HTMLFormElement;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const d = new FormData(form);
      const v = (k: string) => String(d.get(k) ?? '').trim();
      const button = form.querySelector('button')!;
      button.disabled = true;
      const state = document.getElementById('missing-party-state')!;
      state.textContent = 'Enviando…';
      const r = await sendFeedback({ type: 'missing-party', party: v('party'), provinces: v('provinces'), reason: v('reason'), link: v('link') });
      button.disabled = false;
      state.replaceChildren(...feedbackResult(r));
    });
  </script>
</InfoPage>
