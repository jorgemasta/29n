---
// Shell of the static information pages (methodology, parties, reports, rubric).
import '../styles/global.css';
import { dataset } from '../transparencia/datos';
import { REPO } from '../transparencia';
import LetraInicial from './LetraInicial.astro';
import Umami from './Umami.astro';
interface Props { titulo: string; descripcion: string; volver?: { href: string; texto: string } }
const { titulo, descripcion, volver = { href: '/', texto: '← Volver' } } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · 29N</title>
    <meta name="description" content={descripcion} />
    <LetraInicial />
    <Umami />
  </head>
  <body>
    <main class="info">
      <div class="cabecera-fila">
        <a href={volver.href} class="volver">{volver.texto}</a>
        <button type="button" id="aa" class="boton-aa" aria-pressed="false" aria-label="Letra grande">Aa</button>
      </div>
      {dataset.origen !== 'real' && (
        <p class="aviso-prueba" role="note"><strong>Prototipo con datos de prueba.</strong> {dataset.nota}</p>
      )}
      <slot />
    </main>
    <footer class="pie">
      <nav class="enlaces-pie" aria-label="Información">
        <a href="/metodologia/">Cómo funciona</a> · <a href="/partidos/">Partidos y programas</a> · <a href={REPO}>Código abierto</a>
      </nav>
      <p>Proyecto personal de Jorge Masta, sin afiliación a ningún partido.</p>
    </footer>
    <script>
      import { montarBotonLetra } from '../web/letra';
      montarBotonLetra(document.getElementById('aa') as HTMLButtonElement);
    </script>
  </body>
</html>
